# --- LLM ---
GOOGLE_API_KEY=YOUR-GEMINI-API-KEY
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite-preview

# --- Postgres (app data + ADK sessions — same DB, see Phase 1) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pipeline_healer

ADK_SESSION_SERVICE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/pipeline_healer

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- DuckDB sandbox ---
DUCKDB_SANDBOX_DIR=./data/sandbox

# --- App ---
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

API_KEY=dev-local-key-change-me
